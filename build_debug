#!/bin/bash

build_type="Debug"
cache_file="build/CMakeCache.txt"

if [ -f "$cache_file" ] && grep -q "^CMAKE_BUILD_TYPE:STRING=$build_type$" "$cache_file"; then
    echo "Build type already configured as $build_type, skipping configure"
else
    cmake -DCMAKE_BUILD_TYPE=$build_type -B build
fi
cmake --build build -j
